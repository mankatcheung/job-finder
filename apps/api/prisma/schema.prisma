generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  applications JobApplication[]
  apiTokens    ApiToken[]
}

model ApiToken {
  id         String    @id
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JobApplication {
  id          String     @id
  userId      String
  company     String
  role        String
  status      String     @default("draft")
  jobUrl      String?
  location    String?
  salaryRange String?
  description String?
  appliedAt   DateTime?
  starred     Boolean    @default(false)
  source      String?
  followUpAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewRounds InterviewRound[]
  notes           Note[]
  documents       Document[]
  activityLogs    ActivityLog[]
  tags            ApplicationTag[]

  @@index([userId])
  @@index([userId, status])
}

model ApplicationTag {
  id            String         @id
  applicationId String
  name          String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name])
  @@index([applicationId])
}

model ActivityLog {
  id            String         @id
  applicationId String
  actorId       String
  eventType     String
  payload       String
  createdAt     DateTime       @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model InterviewRound {
  id             String         @id
  applicationId  String
  type           String         @default("other")
  scheduledAt    DateTime?
  completedAt    DateTime?
  interviewerName String?
  notes          String?
  outcome        String         @default("pending")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Note {
  id            String         @id
  applicationId String
  content       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Document {
  id            String         @id
  applicationId String
  name          String
  mimeType      String
  sizeBytes     Int
  storageKey    String         @unique
  createdAt     DateTime       @default(now())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
