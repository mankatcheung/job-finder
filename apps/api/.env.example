PORT=3001
NODE_ENV=development

# Database (local dev: file:./local.db, production: Turso URL)
DATABASE_URL=file:/absolute/path/to/job-finder/apps/api/local.db
DATABASE_AUTH_TOKEN=

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Storage: 'local' for dev, 'r2' for production
STORAGE_PROVIDER=local

# Cloudflare R2 (only needed when STORAGE_PROVIDER=r2)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=job-finder-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# CORS
CORS_ORIGIN=http://localhost:3000

# LLM (for job description auto-fill)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Brevo email (for follow-up reminders)
BREVO_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Job Finder
