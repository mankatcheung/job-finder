PORT=3001
NODE_ENV=development

# Database (local dev: file:./local.db, production: Turso URL)
DATABASE_URL=file:/absolute/path/to/job-finder/apps/api/local.db
DATABASE_AUTH_TOKEN=

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Passphrase used to derive the key that encrypts TOTP secrets at rest
TOTP_ENCRYPTION_KEY=change-me-in-production

# Storage: 'local' for dev, 'vercel-blob' for production
STORAGE_PROVIDER=local

# Vercel Blob (used when STORAGE_PROVIDER=vercel-blob) — created automatically,
# and this value injected automatically, when you attach a Blob store to the
# Vercel project. Only needs to be set explicitly here for local dev against
# a real store.
BLOB_READ_WRITE_TOKEN=

# CORS
CORS_ORIGIN=http://localhost:3000

# LLM (for job description auto-fill and cover letter generation)
# Provider: 'openrouter' or 'googleai'
LLM_PROVIDER=openrouter

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google AI Studio (used when LLM_PROVIDER=googleai)
GOOGLEAI_API_KEY=
GOOGLEAI_MODEL=gemini-2.0-flash

# Brevo email (for follow-up reminders)
BREVO_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Job Finder

# Weekly digest trigger secret (set a strong random secret). Accepted
# alongside CRON_SECRET below, kept separate so a leaked digest secret can't
# also trigger reminders.
DIGEST_ADMIN_SECRET=

# Vercel Cron's reserved secret name — Vercel auto-injects this as
# `Authorization: Bearer $CRON_SECRET` when it invokes the digest/reminders
# routes on schedule (see apps/api/vercel.json `crons`). Only needs to be set
# here for local/manual triggering of those routes; on Vercel itself, set as
# a project env var.
CRON_SECRET=

# OAuth sign-in (Google/GitHub). Leave blank to disable — the /auth/oauth/*
# routes respond 503 "not configured" until both id/secret for a provider
# are set. Register a Google OAuth client at
# https://console.cloud.google.com/apis/credentials and a GitHub OAuth App
# at https://github.com/settings/developers; the callback URL to register
# with each is <API origin>/auth/oauth/google/callback (and .../github/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Axiom (observability: logs, traces, metrics). Leave AXIOM_TOKEN/AXIOM_DATASET
# blank to disable entirely — dev works unchanged without them.
AXIOM_TOKEN=
# Events-type dataset, used for logs and traces
AXIOM_DATASET=job-finder-api
# Metrics-type dataset — a separate dataset kind in Axiom. Leave blank to
# disable metrics export while keeping traces and logs active.
AXIOM_METRICS_DATASET=job-finder-api-metrics
